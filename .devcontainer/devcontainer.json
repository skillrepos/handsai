{
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",
    "remoteEnv": {
        "OLLAMA_MODEL": "llama3.2:3b"
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-from-docker:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/python:1": {}
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.terminal.activateEnvInCurrentTerminal": true,
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/py_env/bin/python",
                "github.copilot.enable": { "*": false },
                "github.copilot.enableAutoComplete": false,
                "editor.inlineSuggest.enabled": false,
                "workbench.startupEditor": "readme",
                "mergeInfo.skeletonHighlights": true,
                "mergeInfo.reviewHighlights": true,
                "workbench.editorAssociations": { "*.md": "vscode.markdown.preview.editor" },
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": { "path": "bash", "args": ["-l"] }
                }
            },
            "extensions": ["mathematic.vscode-pdf", "vstirbu.vscode-mermaid-preview"]
        }
    },
    "postCreateCommand": "bash -i scripts/pysetup.sh py_env && bash -i scripts/startup_ollama.sh",
    "postAttachCommand": {
        "ollama": "bash scripts/startOllama.sh",
        "merge-info": "nohup bash -c 'for i in 1 2 3 4 5 6; do code --install-extension ${containerWorkspaceFolder}/.devcontainer/merge-info-0.3.1.vsix --force && break; sleep 10; done' >/tmp/merge-info-install.log 2>&1 &"
    }
}
